# Copy this file to .env and fill in real values.
# The .env file is git-ignored.

# Port the server listens on locally.
PORT=3200

# Password used to sign in at /admin.
# Choose something long and unique before deploying.
ADMIN_PASSWORD=change-me-locally

# Secret used to sign admin session tokens.
# Any long random string works. Do NOT reuse across sites.
ADMIN_SECRET=change-me-to-a-long-random-string
